# ── Optional configuration ────────────────────────────────────────────────────
# Copy this file to .env and edit values as needed.
# All values below are already set to sensible defaults — only edit what you need.

# LLM: "ollama" (local, free) or "openai" (requires API key)
LLM_PROVIDER=ollama
OLLAMA_MODEL=phi3:mini

# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Security — CHANGE THIS before exposing to the internet
JWT_SECRET=change-me-to-a-long-random-string

# Allowed origins for the chat widget (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000
